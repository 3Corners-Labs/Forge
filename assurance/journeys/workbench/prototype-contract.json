{
  "schemaVersion": "forge.workbench-prototype-evidence.v1",
  "status": "candidate",
  "acceptedOracleChanged": false,
  "interfaces": [
    "forge workbench serve",
    "forge workbench chat"
  ],
  "apiVersion": "forge.workbench-api.v1",
  "runtimeMode": "contract-double",
  "requiredHumanActions": [
    "promote exact Requirements Proposal",
    "approve exact Delivery Plan",
    "approve publication of exact verified candidate"
  ],
  "visibleProjections": [
    "agent status and dependency",
    "decision inbox",
    "activity timeline",
    "candidate changed paths",
    "independent test result",
    "intent-to-publication evidence chain"
  ],
