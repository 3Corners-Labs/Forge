    "Go API and terminal tests",
    "TypeScript compile",
    "Vitest presentation tests",
    "Playwright complete journey",
    "axe-core accessibility scan"
  ],
  "forbidden": [
    "free text as execution authority",
    "non-loopback listener",
    "live GitHub effect",
    "merge",
    "release",
    "deployment",
    "production"
  ]
}
