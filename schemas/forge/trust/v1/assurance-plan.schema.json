{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3corners.example/schemas/forge/trust/v1/assurance-plan.schema.json",
  "title": "Forge Assurance Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "digest", "candidateDigest", "planDigest", "riskClass", "classification", "affectedCapabilities", "changedPaths", "controls", "producedBy", "environment", "expiresAt", "evidenceCorrelationId"],
  "properties": {
    "schemaVersion": {"const": "forge.assurance-plan.v1"}, "id": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/$defs/digest"}, "candidateDigest": {"$ref": "#/$defs/digest"},
    "planDigest": {"$ref": "#/$defs/digest"}, "riskClass": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "affectedCapabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "changedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}},
    "producedBy": {"type": "string", "minLength": 1},
    "environment": {"const": "developer-trial"}, "expiresAt": {"type": "string", "format": "date-time"},
    "evidenceCorrelationId": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "control": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "consequential", "candidateOwned"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "consequential": {"type": "boolean"}, "candidateOwned": {"type": "boolean"}
      }
    }
  }
}
