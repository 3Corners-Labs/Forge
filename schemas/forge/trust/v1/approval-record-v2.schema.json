{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.example/schemas/trust/v1/approval-record-v2.schema.json",
  "title": "Forge Approval Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "issuer", "requestId", "requestDigest", "approverId", "scope", "environment", "purpose", "classification", "riskClass", "action", "subjectType", "subjectId", "subjectDigest", "decision", "decidedAt", "expiresAt", "conditions", "policyDecisionIds", "evidenceReferences", "evidenceCorrelationId", "integrity"],
  "allOf": [
    {
      "oneOf": [
        {"properties": {"action": {"const": "forge.delivery.execute-plan"}, "subjectType": {"const": "delivery-plan"}}},
        {"properties": {"action": {"const": "forge.source-control.publish-pr"}, "subjectType": {"const": "verified-candidate"}}}
      ]
    }
  ],
  "properties": {
    "schemaVersion": {"const": "forge.approval-record.v2"},
    "id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "requestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "approverId": {"type": "string", "minLength": 1},
    "delegationReference": {"type": "string", "minLength": 1},
    "scope": {"$ref": "approval-request.schema.json#/$defs/scope"},
    "environment": {"const": "developer-trial"},
    "purpose": {"type": "string", "minLength": 1},
    "classification": {"enum": ["Public", "Internal", "Confidential", "Restricted"]},
    "riskClass": {"enum": ["low", "moderate", "high", "critical"]},
    "action": {"enum": ["forge.delivery.execute-plan", "forge.source-control.publish-pr"]},
    "subjectType": {"enum": ["delivery-plan", "verified-candidate"]},
    "subjectId": {"type": "string", "minLength": 1},
    "subjectDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["approved", "rejected", "revoked"]},
    "decidedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policyDecisionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidenceReferences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "previousRecordId": {"type": "string", "minLength": 1},
    "evidenceCorrelationId": {"type": "string", "minLength": 1},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signatureReference": {"type": "string", "minLength": 1}
      }
    }
  }
}
