{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3corners.example/schemas/forge/trust/v1/worker-request.schema.json",
  "title": "Forge Worker Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "digest", "envelopeId", "delegationId", "planId", "planDigest", "planApprovalRecordId", "contextPackageId", "contextManifestDigest", "sourceRevision", "scope", "action", "transformationId", "transformationVersion", "allowedReadPaths", "allowedWritePaths", "dependencyDigests", "replacements", "limits", "attempt", "expiresAt", "evidenceCorrelationId"],
  "properties": {
    "schemaVersion": {"const": "forge.worker-request.v1"},
    "id": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/$defs/digest"},
    "envelopeId": {"type": "string", "minLength": 1},
    "delegationId": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "planDigest": {"$ref": "#/$defs/digest"},
    "planApprovalRecordId": {"type": "string", "minLength": 1},
    "contextPackageId": {"type": "string", "minLength": 1},
    "contextManifestDigest": {"$ref": "#/$defs/digest"},
    "sourceRevision": {"type": "string", "minLength": 1},
    "scope": {"$ref": "#/$defs/scope"},
    "action": {"const": "forge.worker.prepare-change"},
    "transformationId": {"const": "forge.deterministic-file-replacement.v1"},
    "transformationVersion": {"type": "string", "minLength": 1},
    "allowedReadPaths": {"$ref": "#/$defs/paths"},
    "allowedWritePaths": {"$ref": "#/$defs/paths"},
    "dependencyDigests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "replacements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/replacement"}},
    "limits": {"$ref": "#/$defs/limits"},
    "attempt": {"type": "integer", "minimum": 1},
    "expiresAt": {"type": "string", "format": "date-time"},
    "evidenceCorrelationId": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "workspaceId", "projectId", "repositoryId", "deliveryRunId"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1}, "workspaceId": {"type": "string", "minLength": 1},
        "projectId": {"type": "string", "minLength": 1}, "repositoryId": {"type": "string", "minLength": 1},
        "deliveryRunId": {"type": "string", "minLength": 1}
      }
    },
    "replacement": {
      "type": "object", "additionalProperties": false, "required": ["path", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "expectedSourceDigest": {"$ref": "#/$defs/digest"},
        "content": {"type": "string", "contentEncoding": "base64", "minLength": 1}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxDurationSeconds", "maxProcesses", "maxOutputBytes", "maxChangedFiles", "maxAttempts"],
      "properties": {
        "maxDurationSeconds": {"type": "integer", "minimum": 1}, "maxProcesses": {"type": "integer", "minimum": 1},
        "maxOutputBytes": {"type": "integer", "minimum": 1}, "maxChangedFiles": {"type": "integer", "minimum": 1},
        "maxAttempts": {"type": "integer", "minimum": 1}
      }
    }
  }
}
