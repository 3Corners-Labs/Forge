{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3corners.example/schemas/forge/contributor/v1/autonomy-grant.schema.json",
  "title": "Forge Contributor Autonomy Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "issuer", "accountableOwner", "issuedAt", "expiresAt", "revocation", "repository", "scope", "allowedActions", "mandatoryHumanGates", "destinations", "limits", "verification", "stop", "activation", "integrity"],
  "properties": {
    "schemaVersion": {"const": "forge.contributor-autonomy-grant.v1"},
    "id": {"type": "string", "pattern": "^forge\\.autonomy-grant\\.[a-z0-9.-]+$"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "authorized", "expired", "revoked"]},
    "issuer": {"type": "string", "minLength": 1},
    "accountableOwner": {"type": "string", "minLength": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "revocation": {
      "type": "object", "additionalProperties": false, "required": ["revoked"],
      "properties": {
        "revoked": {"type": "boolean"},
        "revokedAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["slug", "protectedRef", "protectedBaseRevision"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "protectedRef": {"const": "refs/remotes/origin/main"},
        "protectedBaseRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["milestones", "taskPatterns", "capabilityIds", "pathPatterns", "branchPatterns"],
      "properties": {
        "milestones": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "taskPatterns": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "capabilityIds": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "pathPatterns": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "branchPatterns": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "allowedActions": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "mandatoryHumanGates": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "destinations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "value"],
        "properties": {"type": {"const": "github-repository"}, "value": {"type": "string", "minLength": 1}}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxDurationMinutes", "maxExternalCostMinorUnits", "maxAttemptsPerFailure", "maxConcurrency", "maxChangedFiles", "maxChangedLines"],
      "properties": {
        "maxDurationMinutes": {"type": "integer", "minimum": 1},
        "maxExternalCostMinorUnits": {"type": "integer", "minimum": 0},
        "maxAttemptsPerFailure": {"type": "integer", "minimum": 1},
        "maxConcurrency": {"const": 1},
        "maxChangedFiles": {"type": "integer", "minimum": 1},
        "maxChangedLines": {"type": "integer", "minimum": 1}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["requiredChecks", "requiredEvidence", "updateCadence", "terminalState"],
      "properties": {
        "requiredChecks": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "requiredEvidence": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "updateCadence": {"const": "material-progress"},
        "terminalState": {"const": "pull-request-merge-ready"}
      }
    },
    "stop": {
      "type": "object", "additionalProperties": false, "required": ["conditions", "safeRecovery"],
      "properties": {
        "conditions": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "safeRecovery": {"type": "string", "minLength": 1}
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "authenticatedHumanRequired", "protectedRevisionRequired", "candidateMayActivate"],
      "properties": {
        "required": {"const": true},
        "authenticatedHumanRequired": {"const": true},
        "protectedRevisionRequired": {"const": true},
        "candidateMayActivate": {"const": false}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalDigest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
