{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3corners.example/schemas/forge/assurance/v1/journey-scenario.schema.json",
  "title": "Forge Journey Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "owner",
    "lifecycle",
    "riskClass",
    "intentReferences",
    "persona",
    "interface",
    "preconditions",
    "steps",
    "expectedOutcomes",
    "forbiddenOutcomes",
    "evidencePolicy"
  ],
  "properties": {
    "schemaVersion": {"const": "forge.journey-scenario.v1"},
    "id": {"type": "string", "pattern": "^forge\\.journey\\.[a-z0-9][a-z0-9.-]+$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "lifecycle": {
      "enum": ["discovered", "proposed", "reviewed", "accepted", "active", "quarantined", "deprecated", "rejected"]
    },
    "riskClass": {"enum": ["low", "moderate", "high", "critical"]},
    "intentReferences": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "entitlements", "deniedCapabilities", "locale", "accessibilityProfile"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "entitlements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "deniedCapabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "locale": {"type": "string", "minLength": 2},
        "accessibilityProfile": {"type": "string", "minLength": 1},
        "viewport": {"type": "string", "minLength": 1}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "publicEntryPointReference"],
      "properties": {
        "type": {"enum": ["browser", "mobile", "cli", "api", "portal", "other"]},
        "publicEntryPointReference": {"type": "string", "minLength": 1},
        "contractReference": {"type": "string", "minLength": 1}
      }
    },
    "environmentProfile": {"type": "string", "minLength": 1},
    "fixtureReferences": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "checkpoint"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "checkpoint": {"type": "string", "minLength": 1}
        }
      }
    },
    "expectedOutcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "assertion", "oracle"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["business", "interaction", "authorization", "privacy", "accessibility", "reliability", "operational"]},
          "assertion": {"type": "string", "minLength": 1},
          "oracle": {"enum": ["deterministic", "reference", "statistical", "human", "semantic-supporting"]},
          "tolerance": {"type": "string", "minLength": 1}
        }
      }
    },
    "forbiddenOutcomes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumAttempts"],
      "properties": {
        "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "retryableConditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredTypes", "classification", "retentionClass", "redactionRequired"],
      "properties": {
        "requiredTypes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "classification": {"type": "string", "minLength": 1},
        "retentionClass": {"type": "string", "minLength": 1},
        "redactionRequired": {"type": "boolean"}
      }
    }
  }
}
