{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3corners.example/schemas/forge/assurance/v1/journey-result.schema.json",
  "title": "Forge Journey Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scenario",
    "subject",
    "execution",
    "outcome",
    "observations",
    "evidenceReferences",
    "startedAt",
    "finishedAt",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {"const": "forge.journey-result.v1"},
    "id": {"type": "string", "minLength": 1},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationArtifactDigest", "deploymentId", "environmentProfile"],
      "properties": {
        "applicationArtifactDigest": {"type": "string", "minLength": 1},
        "deploymentId": {"type": "string", "minLength": 1},
        "environmentProfile": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionEnvelopeId", "runnerDigest", "identityProfileId", "fixtureDigests"],
      "properties": {
        "executionEnvelopeId": {"type": "string", "minLength": 1},
        "runnerDigest": {"type": "string", "minLength": 1},
        "identityProfileId": {"type": "string", "minLength": 1},
        "fixtureDigests": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "browserVersion": {"type": "string", "minLength": 1},
        "modelReferences": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "outcome": {"enum": ["passed", "failed", "error", "blocked", "quarantined"]},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkpointId", "outcome", "summary"],
        "properties": {
          "checkpointId": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["passed", "failed", "error", "skipped"]},
          "summary": {"type": "string", "minLength": 1},
          "oracle": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidenceReferences": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidenceReferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1},
        "signatureReference": {"type": "string", "minLength": 1}
      }
    }
  }
}
