{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.3corners.example/schemas/intelligence/v1/provider-activation.schema.json",
  "title": "Forge Developer Trial model-provider activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "provider",
    "endpoint",
    "adapterVersion",
    "allowedModelIds",
    "allowedPurposes",
    "allowedClassifications",
    "credentialRef",
    "humanApprovalRef",
    "promptVersion",
    "retention",
    "trainingUse",
    "region",
    "storeProviderState",
    "reasoningEffort",
    "pricing",
    "budgets",
    "activatedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "forge.model-provider-activation.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "provider": {
      "enum": ["openai", "contract-double"]
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "allowedModelIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "allowedPurposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "forge.product.discovery"
      }
    },
    "allowedClassifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["Public", "Internal"]
      }
    },
    "credentialRef": {
      "type": "string",
      "pattern": "^(env|secret):[A-Za-z0-9._:/-]+$"
    },
    "humanApprovalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "retention": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "trainingUse": {
      "const": "disabled"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "storeProviderState": {
      "const": false
    },
    "reasoningEffort": {
      "enum": ["none", "low", "medium", "high", "xhigh", "max"]
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "inputMicrosPerMillionTokens",
        "outputMicrosPerMillionTokens"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "inputMicrosPerMillionTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputMicrosPerMillionTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInputBytes",
        "maxOutputBytes",
        "maxTokens",
        "maxLatencyMs",
        "maxCostMicros",
        "maxTurns",
        "maxSessionTokens",
        "maxSessionCostMicros",
        "maxProjectTokensPerDay",
        "maxProjectCostMicrosPerDay",
        "maxConcurrentRequests"
      ],
      "properties": {
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxLatencyMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxCostMicros": {
          "type": "integer",
          "minimum": 0
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxSessionTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxSessionCostMicros": {
          "type": "integer",
          "minimum": 0
        },
        "maxProjectTokensPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "maxProjectCostMicrosPerDay": {
          "type": "integer",
          "minimum": 0
        },
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "openai"
          }
        },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "endpoint": {
            "pattern": "^https://(api|eu\\.api|us\\.api)\\.openai\\.com/v1/responses$"
          },
          "adapterVersion": {
            "const": "forge.openai-discovery-adapter.v1"
          },
          "allowedModelIds": {
            "maxItems": 1
          },
          "credentialRef": {
            "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
          },
          "promptVersion": {
            "const": "forge.discovery.prompt.v1"
          },
          "region": {
            "enum": ["global", "eu", "us"]
          },
          "pricing": {
            "properties": {
              "inputMicrosPerMillionTokens": {
                "minimum": 1
              },
              "outputMicrosPerMillionTokens": {
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ]
}
