{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3corners.example/schemas/forge/security/v1/rules-of-engagement.schema.json",
  "title": "Forge Security Testing Rules of Engagement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "owners", "purpose", "authorization", "scope", "techniques", "limits", "stopControls", "runner", "evidence", "cleanup", "incident"],
  "properties": {
    "schemaVersion": {"const": "forge.security-rules-of-engagement.v1"},
    "id": {"type": "string", "pattern": "^forge\\.security-roe\\.[a-z0-9.-]+$"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "authorized", "expired", "revoked"]},
    "owners": {
      "type": "object", "additionalProperties": false,
      "required": ["requester", "approver", "operator", "emergencyContact"],
      "properties": {
        "requester": {"type": "string", "minLength": 1},
        "approver": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "emergencyContact": {"type": "string", "minLength": 1}
      }
    },
    "purpose": {
      "type": "object", "additionalProperties": false,
      "required": ["businessPurpose", "threatReferences"],
      "properties": {
        "businessPurpose": {"type": "string", "minLength": 1},
        "threatReferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "targetOwnershipProof", "startsAt", "expiresAt", "targetSetDigest", "runnerConfigurationDigest"],
      "properties": {
        "environment": {"enum": ["local-fixture", "ephemeral-preview", "dedicated-security-test"]},
        "targetOwnershipProof": {"type": "string", "minLength": 1},
        "startsAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "targetSetDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "runnerConfigurationDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["targets", "exclusions", "thirdPartyTargetsAllowed", "productionTargetsAllowed"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "thirdPartyTargetsAllowed": {"const": false},
        "productionTargetsAllowed": {"const": false}
      }
    },
    "techniques": {
      "type": "object", "additionalProperties": false,
      "required": ["permitted", "prohibited"],
      "properties": {
        "permitted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "prohibited": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["activeNetworkRequests", "requestsPerSecond", "concurrency", "durationSeconds", "costUnits", "payloadBytes"],
      "properties": {
        "activeNetworkRequests": {"const": 0},
        "requestsPerSecond": {"const": 0},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 1},
        "durationSeconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "costUnits": {"const": 0},
        "payloadBytes": {"const": 0}
      }
    },
    "stopControls": {
      "type": "object", "additionalProperties": false,
      "required": ["killSwitchEngaged", "failClosed", "stopConditions", "maximumTerminationSeconds"],
      "properties": {
        "killSwitchEngaged": {"const": true},
        "failClosed": {"const": true},
        "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "maximumTerminationSeconds": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "mode", "scopeEnforcement", "generatedContentMayConfigure", "autonomous"],
      "properties": {
        "enabled": {"const": false},
        "mode": {"const": "contract-only"},
        "scopeEnforcement": {"const": "external-deterministic-controller"},
        "generatedContentMayConfigure": {"const": false},
        "autonomous": {"const": false}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "recipients", "retentionClass", "redactionRequired", "coverageDisclosureRequired"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "recipients": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "retentionClass": {"type": "string", "minLength": 1},
        "redactionRequired": {"const": true},
        "coverageDisclosureRequired": {"const": true}
      }
    },
    "cleanup": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "incident": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
