    {"id":"denial-of-wallet","threat":"Denial of wallet or capacity","owner":"Forge Reliability and Intelligence Architecture","controls":["Admission control","Budgets","Deadlines","Bounded fallback"],"enforcementPoints":["Delivery control","Execution envelope","Tool and model brokers"],"negativeTests":[{"id":"g6-budget-exhaustion","phase":"m1-exit","fixture":"security/fixtures/expired-authority.json","expected":"Exhaustion stops cleanly without unauthorized fallback or cascade","disclosureSafe":true}],"evidenceObligations":["Declared budget","Usage","Stop reason"]},
