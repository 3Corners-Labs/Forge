    {"id":"synthetic-user-data-leakage","threat":"Synthetic-user data leakage","owner":"Forge Privacy and Quality Architecture","controls":["Synthetic identities","Seeded markers","Redaction","Classified retention"],"enforcementPoints":["CLI","Telemetry","Evidence","Provider adapters"],"negativeTests":[{"id":"g6-seeded-data-leakage","phase":"m1-exit","fixture":"security/fixtures/seeded-sensitive-data.json","expected":"Secret and personal markers are absent from every forbidden destination","disclosureSafe":true}],"evidenceObligations":["Seed digest","Destination coverage","Redaction result"]},
