    {"id":"prompt-injection","threat":"Direct or indirect prompt injection","owner":"Forge Security and Context Architecture","controls":["Instruction/data separation","Immutable execution envelope","Schema-validated output","Separate side-effect gates"],"enforcementPoints":["Context assembly","Tool broker","Worker launcher"],"negativeTests":[{"id":"g6-prompt-injection","phase":"m1-exit","fixture":"security/fixtures/malicious-untrusted-input.json","expected":"Content cannot widen authority, retrieve another scope, or publish","disclosureSafe":true}],"evidenceObligations":["Input provenance","Envelope digest","Denied action reason"]},
    {"id":"confused-deputy","threat":"Confused deputy","owner":"Forge Identity and Policy Architecture","controls":["Audience-bound delegation","Immutable server-derived scope","Action/resource policy"],"enforcementPoints":["Public CLI","Policy","Every receiving capability"],"negativeTests":[{"id":"g6-confused-deputy","phase":"m1-exit","fixture":"security/fixtures/cross-scope-request.json","expected":"Cross-purpose and cross-scope request returns forbidden","disclosureSafe":true}],"evidenceObligations":["Principal and delegation references","Policy decision","Safe denial"]},
    {"id":"cross-tenant-leakage","threat":"Cross-tenant leakage","owner":"Forge Tenant and Security Architecture","controls":["Server-derived scope","Partition enforcement","Classification and disclosure policy"],"enforcementPoints":["API","Store","Cache","Queue","Index","Telemetry","Evidence"],"negativeTests":[{"id":"g6-cross-tenant","phase":"before-trial","fixture":"security/fixtures/cross-scope-request.json","expected":"No existence or content disclosure across every adapter","disclosureSafe":true}],"evidenceObligations":["Adapter coverage matrix","Safe denial codes","Leakage-seed scan"]},
    {"id":"malicious-repository","threat":"Malicious repository execution","owner":"Forge Execution and Security Architecture","controls":["Ephemeral worker","No default secrets","Deny-by-default egress","Resource and time bounds"],"enforcementPoints":["External worker launcher","Operating-system sandbox","Secret resolver"],"negativeTests":[{"id":"g6-malicious-repository","phase":"m1-exit","fixture":"security/fixtures/malicious-untrusted-input.json","expected":"Repository content cannot escape, exfiltrate, fork-bomb, or gain credentials","disclosureSafe":true}],"evidenceObligations":["Worker input/output digests","Resource usage","Cleanup result"]},
    {"id":"tool-abuse","threat":"Tool abuse or unexpected side effect","owner":"Forge Tool and Policy Architecture","controls":["Tool risk metadata","Validated arguments","Destination policy","Idempotency and approval"],"enforcementPoints":["Tool broker","Policy","Execution envelope"],"negativeTests":[{"id":"g6-tool-abuse","phase":"m1-exit","fixture":"security/fixtures/expired-authority.json","expected":"Unauthorized destination and expired authority are denied before dispatch","disclosureSafe":true}],"evidenceObligations":["Tool version","Argument digest","Decision and invocation receipt"]},
    {"id":"approval-replay","threat":"Approval replay","owner":"Forge Approval and Release Architecture","controls":["Digest/action/actor/environment/expiry binding","Re-evaluation before publication"],"enforcementPoints":["Approval","Source-control adapter"],"negativeTests":[{"id":"g6-approval-replay","phase":"m1-exit","fixture":"security/fixtures/tampered-artifact.json","expected":"Changed digest or expired approval blocks publication","disclosureSafe":true}],"evidenceObligations":["Approval record","Observed candidate digest","Publication denial"]},
    {"id":"poisoned-knowledge","threat":"Poisoned knowledge or memory","owner":"Forge Knowledge and Security Architecture","controls":["Provenance","Lifecycle and confidence","Independent promotion","Revocation"],"enforcementPoints":["Knowledge retrieval","Context assembly","Memory promotion"],"negativeTests":[{"id":"g6-poisoned-knowledge","phase":"m1-exit","fixture":"security/fixtures/malicious-untrusted-input.json","expected":"Malicious and superseded sources remain labelled or excluded and never grant authority","disclosureSafe":true}],"evidenceObligations":["Source revision","Lifecycle","Omissions and conflicts"]},
    {"id":"provider-leakage","threat":"Model or provider data leakage","owner":"Forge Intelligence and Privacy Architecture","controls":["Classification eligibility","Purpose minimization","Destination allow-list","Local fallback only when pre-authorized"],"enforcementPoints":["Context assembly","Provider adapter","Policy"],"negativeTests":[{"id":"g6-provider-leakage","phase":"m1-exit","fixture":"security/fixtures/seeded-sensitive-data.json","expected":"Restricted markers never reach an ineligible provider","disclosureSafe":true}],"evidenceObligations":["Eligibility decision","Destination","Redaction assertion"]},
